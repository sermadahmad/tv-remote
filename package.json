{
  "name": "universal-tv-remote",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "58.0.23",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "1.69.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.6",
    "jest": "30",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "doctor": "expo-doctor",
    "native:generate": "node scripts/generate-protocol.mjs",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "assets:check": "node scripts/generate-brand-assets.mjs --check && node scripts/verify-brand-assets.mjs",
    "store:generate": "node scripts/generate-play-assets.mjs",
    "store:check": "node scripts/generate-play-assets.mjs --check && node scripts/verify-play-assets.mjs",
    "android:release:check": "node scripts/verify-protobuf-release.mjs"
  },
  "private": true,
  "engines": {
    "node": "^24.19.0"
  }
}
