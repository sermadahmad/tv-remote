{
  "expo": {
    "name": "Universal TV Remote",
    "slug": "universal-tv-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "universaltvremote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.universaltv.remote",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Find and securely connect to your Android TV or Google TV on the same Wi-Fi network.",
        "NSBonjourServices": ["_androidtvremote2._tcp"]
      }
    },
    "android": {
      "package": "dev.universaltv.remote",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": { "deploymentTarget": "16.4" }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101511",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
