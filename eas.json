{
  "cli": { "version": ">=27.5.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" }
    },
    "ui-test": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "ui-test" },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "production": {
      "node": "24.19.0",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "ANDROID_TARGET_SDK": "36" },
      "android": { "buildType": "app-bundle", "image": "sdk-58" }
    }
  },
  "submit": {
    "internal": {
      "android": { "track": "internal", "releaseStatus": "completed" }
    }
  }
}
